{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hindianime-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CF_PROXY_URL": "https://cloud.hindi-anime.com",
    "NEXT_PUBLIC_CF_PROXY_URL": "https://cloud.hindi-anime.com",
    "NEXT_PUBLIC_SOURCE_WORKER_ENABLED": "true"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hindianime-preview"
    }
  ],
  "observability": {
    "enabled": true
  }
}
