# ==============================================================================
# 1. SECURITY, CREDENTIALS & ENVIRONMENT SECRETS (NEVER COMMIT)
# ==============================================================================
# Environment variable files
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.local
# Allow .env.example template for documentation
!.env.example

# Sensitive keys, certificates, and private tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
*.pub
*.asc
*.gpg

# Cloud & DB credentials
*credentials*.json
*credentials*.env
*.env.vault
secrets/
secret/
private/

# ==============================================================================
# 2. DEPENDENCIES
# ==============================================================================
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==============================================================================
# 3. NEXT.JS & BUILD OUTPUTS
# ==============================================================================
.next/
out/
build/
dist/
storybook-static/

# ==============================================================================
# 4. TYPESCRIPT
# ==============================================================================
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts.bak

# ==============================================================================
# 5. LOGS & RUNTIME DIAGNOSTICS
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ==============================================================================
# 6. TESTING & COVERAGE
# ==============================================================================
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ==============================================================================
# 7. IDE, EDITORS & AI AGENTS
# ==============================================================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.code-workspace

# AI agents, scratchpads and caches
.cursor/
.windsurf/
.gemini/
.system_generated/
scratch/
browser/

# ==============================================================================
# 8. OPERATING SYSTEM & TEMPORARY FILES
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux / Vim / Backup files
*~
*.swp
*.swo
*.tmp
*.bak

# ==============================================================================
# 9. HOSTING & DEPLOYMENT ARTIFACTS
# ==============================================================================
.vercel
.turbo/
.serverless/
