# GEMINI_API_KEY: Optional
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT="3000"
NODE_ENV="development"

# Global API Bearer token — required by all protected /api/* endpoints on Koyeb.
# Set this in Koyeb's dashboard environment variables. For local testing, set it here.
# Leave empty to disable auth (dev mode). NEVER commit a real token to git.
AUTH_TOKEN=""

# Shared Proxy Secret (optional: if set, requires x-hindianime-proxy-secret header on /stream)
HINDIANIME_PROXY_SECRET=""

# Allowed Origins for CORS (comma separated, supports *.vercel.app, localhost, or * to allow all)
ALLOWED_ORIGINS="https://hindi-anime.com,https://hindianime-seven.vercel.app,http://localhost:3000,http://localhost:3001"

# Upstream Toko API endpoint
TOKO_API_URL="https://api-delta-taupe-46.vercel.app"
