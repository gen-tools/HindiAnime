# ── Public (browser-visible) ──────────────────────────────────────────────────
# Cloudflare Worker URL used by the browser to fetch streams and homepage data.
NEXT_PUBLIC_CF_PROXY_URL=https://wispy-cherry-6934.sheztech.workers.dev

# Set to "true" when the updated cloudflare-worker.js with /sources is deployed.
# Set to "false" to resolve streams via Next.js /api/stream-proxy directly.
NEXT_PUBLIC_SOURCE_WORKER_ENABLED=false

# Fallback to /api/stream-proxy if worker streams are unavailable.
NEXT_PUBLIC_VERCEL_STREAM_FALLBACK=true

# ── Server-side only (not exposed to browser) ─────────────────────────────────
# Same Worker URL, used by Next.js API routes (stream-proxy, worker-auth).
CF_PROXY_URL=https://wispy-cherry-6934.sheztech.workers.dev

# Shared secret that matches the HINDIANIME_PROXY_SECRET binding in the Worker.
# Used to sign HLS proxy URLs and authenticate Toko backend calls.
CF_PROXY_SHARED_SECRET=your-hindianime-proxy-secret-here
